# --- Docker Hub bilgileri ---
dockerhub_username: "savaseeratesli"
dockerhub_password: ""

# --- Kubernetes config (k3s kubeconfig içeriği) /etc/rancher/k3s/k3s.yaml ---
kubeconfig: |
  apiVersion: v1
  clusters:
  - cluster:
      certificate-authority-data: 
      server: https://192.168.68.50:6443
    name: default
  contexts:
  - context:
      cluster: default
      user: default
    name: default
  current-context: default
  kind: Config
  preferences: {}
  users:
  - name: default
    user:
      client-certificate-data: 
      client-key-data: 
